<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark by default; Compose draws everything, this only colours the window before the first frame. -->
    <style name="Theme.Gyro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gyro_background</item>
        <item name="android:colorAccent">@color/gyro_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
